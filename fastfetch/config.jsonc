{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/data/data/com.termux/files/home/.config/fastfetch/descargas.gif",
    "width": 21,
    "printRemaining": false,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 2,
      "bottom": 0
    }
  },
  "display": {
    "separator": "  ",
    "disableLinewrap": true,
    "hideCursor": true,
    "brightColor": false,
    "key": {
      "width": 10,
      "type": "string"
    },
    "size": {
      "ndigits": 1,
      "maxPrefix": "GB"
    },
    "percent": {
      "type": [
        "num"
      ],
      "ndigits": 0
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "{#blue}󰆍 termux{#} {#dim_black}·{#} {#magenta}material you{#}"
    },
    {
      "type": "custom",
      "format": "{#blue}──────────{#magenta}──────────{#cyan}──────────{#}"
    },
    {
      "type": "os",
      "key": "{#blue}󰀲 os{#}",
      "format": "{#white}{name} {#white}{version}{#} {#dim_black}->{#} {#blue}{arch}{#}"
    },
    {
      "type": "host",
      "key": "{#blue}󰄜 device{#}",
      "outputColor": "light_white"
    },
    {
      "type": "command",
      "key": "{#blue}󰌽 kernel{#}",
      "outputColor": "light_white",
      "text": "uname -r | cut -d- -f1-2",
      "format": "{}"
    },
    {
      "type": "uptime",
      "key": "{#blue}󰥔 uptime{#}",
      "format": "{#white}{days}{#}{#dim_black}d{#} {#white}{hours}{#}{#dim_black}h{#} {#white}{minutes}{#}{#dim_black}m{#}"
    },
    {
      "type": "custom",
      "format": " "
    },
    {
      "type": "cpu",
      "key": "{#cyan}󰻠 cpu{#}",
      "format": "{#white}{cores-logical}{#}{#cyan}x{#} {#dim_black}=>{#} {#white}{freq-max}{#}",
      "temp": false
    },
    {
      "type": "memory",
      "key": "{#cyan}󰍛 memory{#}",
      "format": "{#white}{used}{#} {#dim_black}/{#} {#white}{total}{#} {#dim_black}·{#} {#cyan}{percentage}{#}"
    },
    {
      "type": "command",
      "key": "{#cyan}󰋊 disk{#}",
      "outputColor": "light_white",
      "text": "df -h /data/data/com.termux/files/home | awk 'NR==2 {print $3 \" / \" $2 \" · \" $5}'",
      "format": "{}"
    }
  ]
}