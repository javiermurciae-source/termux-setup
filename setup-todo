step_core_termux() {
    log 7 "Verificando Core-Termux y Agentes de IA..."
    
    if [ -x "$PREFIX/bin/core" ]; then
        ok "Core-Termux ya está instalado. ¡Omitiendo reinstalación! ⚡"
    else
        warn "Instalando motor Core-Termux..."
        curl -fSLO https://raw.githubusercontent.com/DevCoreXOfficial/core-termux/main/install.sh
        bash install.sh || warn "Advertencia: El instalador de Core-Termux arrojó un error."
        rm -f install.sh
    fi
    
    if [ -x "$PREFIX/bin/core" ]; then
        log 7.1 "Sincronizando módulos de IA (opencode, kilocode, freebuff, antigravity-cli)..."
        "$PREFIX/bin/core" install ai --opencode --kilocode-cli --freebuff --antigravity-cli --keelcode --supercode --mimocode --codex --qwen-code --cline
        ok "Asistentes de IA listos (OpenCode, KiloCode, FreeBuff, Antigravity, KeelCode, SuperCode, MiMoCode, Codex, Qwen, Cline) 🤖"
        
        log 7.2 "Sincronizando herramientas Dev (core install dev)..."
        "$PREFIX/bin/core" install dev
        "$PREFIX/bin/core" install npm
        ok "Herramientas de desarrollo (Dev, NPM) instaladas 🛠️"
    else
        warn "Fallo crítico: No se encontró 'core'. Saltando IA y Dev."
    fi
    ok "¡Ecosistema Core-Termux al 100%!"
}

