#!/data/data/com.termux/files/usr/bin/python3
import imaplib
import email
from email.header import decode_header
import getpass
import sys
import json
import os
import re

CONFIG_FILE = os.path.expanduser("~/.config/mail_accounts.json")
BACKUP_CONFIG = os.path.expanduser("~/termux-setup/mail_accounts.json")
IMAP_SERVER = "imap.gmail.com"
IMAP_PORT = 993

# Paleta de Colores ANSI Moderna
C_CYAN = "\033[1;36m"
C_BLUE = "\033[1;34m"
C_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
C_MAGENTA = "\033[1;35m"
C_RED = "\033[1;31m"
C_WHITE = "\033[1;37m"
C_DIM = "\033[2;37m"
C_UNDERLINE = "\033[4m"
C_RESET = "\033[0m"

C_URL = f"{C_CYAN}{C_UNDERLINE}"

def highlight_urls(text):
    url_pattern = r'(https?://[^\s<>"\'\)]+)'
    return re.sub(url_pattern, f"{C_URL}\\1{C_RESET}", text)

def load_accounts():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
                if data:
                    return data
        except Exception:
            pass
    
    if os.path.exists(BACKUP_CONFIG):
        try:
            with open(BACKUP_CONFIG, "r") as f:
                data = json.load(f)
                if data:
                    save_accounts(data)
                    return data
        except Exception:
            pass

    return {}

def save_accounts(accounts):
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    with open(CONFIG_FILE, "w") as f:
        json.dump(accounts, f, indent=2)
    os.chmod(CONFIG_FILE, 0o600)
    
    try:
        os.makedirs(os.path.dirname(BACKUP_CONFIG), exist_ok=True)
        with open(BACKUP_CONFIG, "w") as f:
            json.dump(accounts, f, indent=2)
        os.chmod(BACKUP_CONFIG, 0o600)
    except Exception:
        pass

def delete_account(name):
    accounts = load_accounts()
    if name in accounts:
        del accounts[name]
        save_accounts(accounts)

def test_imap_connection(email_user, email_pass):
    try:
        mail = imaplib.IMAP4_SSL(IMAP_SERVER, IMAP_PORT)
        mail.login(email_user, email_pass)
        return mail, None
    except Exception as e:
        return None, e

def add_account(accounts):
    print(f"{C_YELLOW}➕ Configurar Cuenta de Gmail{C_RESET}\n")
    
    # 1. Correo
    sys.stdout.write(f"{C_WHITE}📧 Correo de Gmail:{C_RESET} ")
    sys.stdout.flush()
    email_in = sys.stdin.readline().strip()
    while not email_in:
        sys.stdout.write(f"{C_RED}⚠️ El correo es obligatorio:{C_RESET} ")
        sys.stdout.flush()
        email_in = sys.stdin.readline().strip()

    # 2. Contraseña de Aplicación
    pass_in = ""
    try:
        pass_in = getpass.getpass(f"{C_WHITE}🔑 Contraseña de Aplicación (16 letras):{C_RESET} ").strip()
    except Exception:
        sys.stdout.write(f"{C_WHITE}🔑 Contraseña de Aplicación (16 letras):{C_RESET} ")
        sys.stdout.flush()
        pass_in = sys.stdin.readline().strip()

    while not pass_in:
        try:
            pass_in = getpass.getpass(f"{C_RED}⚠️ La contraseña es obligatoria:{C_RESET} ").strip()
        except Exception:
            sys.stdout.write(f"{C_RED}⚠️ La contraseña es obligatoria:{C_RESET} ")
            sys.stdout.flush()
            pass_in = sys.stdin.readline().strip()

    # 3. Nombre o Alias
    sys.stdout.write(f"{C_WHITE}🏷️  Nombre o Alias para esta cuenta (ej: Personal / Trabajo) [Enter para usar correo]:{C_RESET} ")
    sys.stdout.flush()
    name_in = sys.stdin.readline().strip()
    if not name_in:
        name_in = email_in

    # 4. Validar conexión EN VIVO antes de guardar
    print(f"\n{C_BLUE}⏳ Verificando credenciales con Gmail...{C_RESET}")
    mail, err = test_imap_connection(email_in, pass_in)
    
    if err:
        print(f"\n{C_RED}❌ Error de conexión o credenciales inválidas:{C_RESET} {err}")
        print(f"{C_RED}🚫 NO se guardó la cuenta porque las credenciales fallaron.{C_RESET}")
        print(f"{C_YELLOW}💡 Tip: Recuerda usar una App Password de 16 letras generada en Google.{C_RESET}\n")
        sys.exit(1)

    # Solo si la conexión fue exitosa al 100% se guarda
    accounts[name_in] = {"email": email_in, "password": pass_in}
    save_accounts(accounts)
    print(f"{C_GREEN}✅ ¡Credenciales verificadas y cuenta '{name_in}' guardada exitosamente!{C_RESET}\n")
    return name_in, mail

print(f"{C_CYAN}╭──────────────────────────────────────────────────╮{C_RESET}")
print(f"{C_CYAN}│        📬  STREAM-MAIL CLI (GMAIL IMAP)  ⚡      │{C_RESET}")
print(f"{C_CYAN}╰──────────────────────────────────────────────────╯{C_RESET}\n")

accounts = load_accounts()
mail_conn = None

if "--add" in sys.argv or "-a" in sys.argv:
    selected_name, mail_conn = add_account(accounts)
elif not accounts:
    print(f"{C_YELLOW}👋 ¡Bienvenido! Configura tu primera cuenta:{C_RESET}\n")
    selected_name, mail_conn = add_account(accounts)
elif len(accounts) == 1:
    selected_name = list(accounts.keys())[0]
else:
    print(f"{C_MAGENTA}📂 Cuentas guardadas:{C_RESET}")
    acc_list = list(accounts.keys())
    for idx, name in enumerate(acc_list, 1):
        email_addr = accounts[name]["email"]
        print(f"  {C_CYAN}[{idx}]{C_RESET} {C_WHITE}{name}{C_RESET} {C_DIM}({email_addr}){C_RESET}")
    print(f"  {C_YELLOW}[+]{C_RESET} Añadir otra cuenta")
    
    sys.stdout.write(f"\n{C_GREEN}👉 Selecciona una cuenta [1-{len(acc_list)} o +]:{C_RESET} ")
    sys.stdout.flush()
    choice = sys.stdin.readline().strip()
    
    if choice == "+":
        selected_name, mail_conn = add_account(accounts)
    elif choice.isdigit() and 1 <= int(choice) <= len(acc_list):
        selected_name = acc_list[int(choice) - 1]
    else:
        selected_name = acc_list[0]

active_acc = accounts[selected_name]
EMAIL_USER = active_acc["email"]
EMAIL_PASS = active_acc["password"]

# Conectar si no venía conectada de la validación
if not mail_conn:
    print(f"{C_BLUE}🔗 Conectando a {C_WHITE}{EMAIL_USER}{C_BLUE}...{C_RESET}")
    mail_conn, err = test_imap_connection(EMAIL_USER, EMAIL_PASS)
    if err:
        print(f"\n{C_RED}❌ Error al conectar:{C_RESET} {err}")
        if "AUTHENTICATIONFAILED" in str(err):
            print(f"{C_RED}⚠️ La cuenta '{selected_name}' tiene credenciales inválidas.{C_RESET}")
            delete_account(selected_name)
            print(f"{C_YELLOW}🗑️ Se eliminó automáticamente la cuenta inválida de la lista.{C_RESET}")
            print(f"{C_YELLOW}💡 Vuelve a ejecutar 'readmail' para configurarla con una clave válida.{C_RESET}\n")
        sys.exit(1)

COUNT = 5

try:
    mail = mail_conn
    mail.select("inbox")

    status, messages = mail.search(None, "ALL")
    if status != "OK" or not messages[0]:
        print(f"{C_YELLOW}📭 La bandeja de entrada está vacía.{C_RESET}")
        mail.logout()
        sys.exit(0)

    mail_ids = messages[0].split()
    latest_ids = mail_ids[-COUNT:]

    print(f"\n{C_GREEN}📩 --- ÚLTIMOS {len(latest_ids)} CORREOS EN BANDEJA ({selected_name.upper()}) --- 📩{C_RESET}\n")

    for mail_id in reversed(latest_ids):
        res, msg_data = mail.fetch(mail_id, "(RFC822)")
        for response_part in msg_data:
            if isinstance(response_part, tuple):
                msg = email.message_from_bytes(response_part[1])
                
                raw_subject = msg.get("Subject", "(Sin Asunto)")
                subject, encoding = decode_header(raw_subject)[0]
                if isinstance(subject, bytes):
                    subject = subject.decode(encoding if encoding else "utf-8", errors="ignore")
                
                sender = msg.get("From", "(Desconocido)")
                date_str = msg.get("Date", "")

                body = ""
                if msg.is_multipart():
                    for part in msg.walk():
                        content_type = part.get_content_type()
                        content_disposition = str(part.get("Content-Disposition"))
                        if content_type == "text/plain" and "attachment" not in content_disposition:
                            payload = part.get_payload(decode=True)
                            if payload:
                                body = payload.decode(errors="ignore")
                                break
                    if not body:
                        for part in msg.walk():
                            if part.get_content_type() == "text/html":
                                payload = part.get_payload(decode=True)
                                if payload:
                                    body = payload.decode(errors="ignore")
                                    break
                else:
                    payload = msg.get_payload(decode=True)
                    if payload:
                        body = payload.decode(errors="ignore")

                print(f"{C_CYAN}┌─────────────────────────────────────────────────────────────┐{C_RESET}")
                print(f"{C_CYAN}│{C_RESET} {C_YELLOW}👤 De:{C_RESET}      {C_WHITE}{sender}{C_RESET}")
                print(f"{C_CYAN}│{C_RESET} {C_BLUE}📅 Fecha:{C_RESET}   {C_DIM}{date_str}{C_RESET}")
                print(f"{C_CYAN}│{C_RESET} {C_GREEN}📌 Asunto:{C_RESET}  {C_WHITE}{subject}{C_RESET}")
                print(f"{C_CYAN}├─────────────────────────────────────────────────────────────┤{C_RESET}")
                print(f"{C_CYAN}│{C_RESET} {C_MAGENTA}📄 Mensaje:{C_RESET}")
                for line in body.strip().splitlines():
                    colored_line = highlight_urls(line)
                    print(f"{C_CYAN}│{C_RESET}   {colored_line}")
                print(f"{C_CYAN}└─────────────────────────────────────────────────────────────┘{C_RESET}\n")

    mail.logout()
    print(f"{C_GREEN}✨ Sincronización completada.{C_RESET}\n")

except Exception as e:
    print(f"\n{C_RED}❌ Error durante la lectura:{C_RESET} {e}\n")
OTP_EOF
