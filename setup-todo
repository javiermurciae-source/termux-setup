#!/data/data/com.termux/files/usr/bin/python3
"""
🌐 NETSCAN CLI - Escáner de Red Local (IPs, MACs, Fabricantes y Hostnames)
Usa arp, nmap y /proc/net/arp para listar todos los dispositivos conectados a tu Wi-Fi.
"""

import subprocess
import os
import sys
import re
import socket

# Paleta de Colores ANSI
C_CYAN = "\033[1;36m"
C_BLUE = "\033[1;34m"
C_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
