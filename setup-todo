    cat << 'VOICE_EOF' > "$HOME_DIR/opencode-voice.py"
#!/data/data/com.termux/files/usr/bin/python3
"""
🎙️ OPENCODE ASISTENTE POR VOZ CON ACTIVACIÓN AUTOMÁTICA DEL MICRÓFONO
- Lanza automáticamente el botón de micrófono por hardware/input keyevent
- OpenCode procesa con contexto real del sistema
- Habla la respuesta por el altavoz (Google TTS)
- Vuelve a activar el micrófono automáticamente
"""

import subprocess
import os
import sys
import json
import time
import re

C_CYAN = "\033[1;36m"
C_BLUE = "\033[1;34m"
C_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
C_MAGENTA = "\033[1;35m"
C_RED = "\033[1;31m"
C_WHITE = "\033[1;37m"
C_DIM = "\033[2;37m"
C_RESET = "\033[0m"

def clean_for_tts(text):
    if not text:
        return ""
    text = re.sub(r'```[\s\S]*?```', ' He generado el bloque de código en pantalla. ', text)
    text = re.sub(r'https?://\S+', ' un enlace web ', text)
    text = re.sub(r'[#*_`~>|┌┐└┘├┤│─╭╮╰╯═]', '', text)
    text = ' '.join(text.split())
    if len(text) > 350:
        text = text[:350] + "... y los demás detalles están en pantalla."
    return text

def speak(text):
    if not text:
        return
    clean_text = clean_for_tts(text)
    if not clean_text or len(clean_text) < 2:
        return
    
    try:
        escaped = clean_text.replace('"', '\\"').replace("'", "")
        cmd = f'am broadcast --user 0 -a com.termux.api.action.TTS_SPEAK -n com.termux.api/.TermuxApiReceiver --es text "{escaped}"'
        subprocess.run(["su", "-c", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

    try:
        subprocess.run(["espeak", "-v", "es", "-s", "165", clean_text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def trigger_voice_mic_auto():
    """Lanza el micrófono de dictado de voz de Android automáticamente usando KeyEvent 231 (KEYCODE_VOICE_ASSIST)"""
    try:
        subprocess.run(["su", "-c", "input keyevent 231 2>/dev/null || input keyevent KEYCODE_VOICE_ASSIST 2>/dev/null"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def get_system_context():
    ctx = []
    ctx.append("• Dispositivo: Android Infinix X6878 (ARM64)")
    ctx.append("• Entorno: Termux + Fish Shell")
    ctx.append("• Root: DISPONIBLE (su/tsu)")
    
    home = os.path.expanduser("~")
    if os.path.exists(home):
        scripts = [f for f in os.listdir(home) if f.endswith(".sh") or f.endswith(".py")]
        ctx.append(f"• Scripts: {', '.join(scripts)}")

    mail_cfg = os.path.expanduser("~/.config/mail_accounts.json")
    if os.path.exists(mail_cfg):
        try:
            with open(mail_cfg) as f:
                accs = json.load(f)
                ctx.append(f"• Cuentas IMAP: {', '.join(accs.keys())}")
        except Exception:
            pass

    return "\n".join(ctx)

def main():
    print(f"{C_CYAN}╭────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│   🎙️  OPENCODE CONVERSACIÓN TOTAL POR VOZ (AUTO)  ⚡   │{C_RESET}")
    print(f"{C_CYAN}╰────────────────────────────────────────────────────────╯{C_RESET}\n")

    if "--auth" in sys.argv or "auth" in sys.argv or "--providers" in sys.argv:
        os.system("opencode auth")
        sys.exit(0)

    system_context = get_system_context()
    speak("Asistente de voz activado. Te escucho.")

    while True:
        print(f"\n{C_YELLOW}🎙️  [MICRÓFONO LANZADO AUTOMÁTICAMENTE] ¡Habla ahora!...{C_RESET}")
        
        # Activar micrófono de Google por hardware/input automáticamente
        trigger_voice_mic_auto()
        
        sys.stdout.write(f"{C_GREEN}🗣️  Tú: {C_RESET}")
        sys.stdout.flush()
        
        user_prompt = sys.stdin.readline().strip()

        if not user_prompt:
            continue

        if user_prompt.lower() in ["salir", "exit", "quit", "terminar", "apagar", "chao"]:
            print(f"\n{C_YELLOW}👋 Finalizando asistente de voz. ¡Hasta luego!{C_RESET}\n")
            speak("Hasta luego")
            break

        print(f"\n{C_BLUE}🤖 OpenCode procesando...{C_RESET}\n")

        master_prompt = f"""[DIRECTIVA OBLIGATORIA DE VOZ]:
Eres un asistente de voz interactivo en Termux Android.
CADA RESPUESTA que des debe ser concisa, clara y accionable porque será sintetizada en voz alta por el altavoz.
Usa las herramientas de Termux y del sistema según corresponda.

[CONTEXTO DEL SISTEMA]:
{system_context}

[INSTRUCCIÓN DEL USUARIO]:
{user_prompt}"""

        opencode_bin = "/data/data/com.termux/files/usr/bin/opencode"
        full_response = ""

        if os.path.exists(opencode_bin):
            cmd = [opencode_bin, "run", master_prompt]
            try:
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                response_chunks = []
                for line in proc.stdout:
                    sys.stdout.write(line)
                    sys.stdout.flush()
                    response_chunks.append(line)
                proc.wait()
                full_response = "".join(response_chunks)
            except Exception as e:
                print(f"{C_RED}❌ Error:{C_RESET} {e}")
        else:
            os.system(f"opencode run '{master_prompt}' 2>/dev/null || agy '{user_prompt}'")

        # ¡HABLARRRR LA RESPUESTA EN VOZ ALTA!
        if full_response.strip():
            print(f"\n{C_GREEN}🗣️ Hablando respuesta por el altavoz...{C_RESET}")
            speak(full_response)

        print(f"\n{C_CYAN}────────────────────────────────────────────────────────{C_RESET}")

if __name__ == "__main__":
    main()
VOICE_EOF
chmod +x "$HOME_DIR/opencode-voice.py"
    ln -sf "$HOME_DIR/opencode-voice.py" "$PREFIX/bin/openvoice"
    ln -sf "$HOME_DIR/opencode-voice.py" "$PREFIX/bin/ai-voice"
    ok "Agente OpenCode con Voz y Contexto vivo instalado (Comando: openvoice / ai-voice) 🎙️"

    if [ -x "$PREFIX/bin/core" ]; then
        log 7.1 "Sincronizando módulos de IA (opencode, kilocode, freebuff, antigravity-cli)..."
        "$PREFIX/bin/core" install ai --opencode --kilocode-cli --freebuff --antigravity-cli --keelcode --supercode --mimocode --codex --qwen-code --cline
        ok "Asistentes de IA listos (OpenCode, KiloCode, FreeBuff, Antigravity, KeelCode, SuperCode, MiMoCode, Codex, Qwen, Cline) 🤖"
        
        log 7.2 "Sincronizando herramientas Dev (core install dev)..."
        "$PREFIX/bin/core" install dev
        "$PREFIX/bin/core" install npm
        ok "Herramientas de desarrollo (Dev, NPM) instaladas 🛠️"
    else
        warn "Fallo crítico: No se encontró 'core'. Saltando IA y Dev."
    fi
    ok "¡Ecosistema Core-Termux al 100%!"
}

