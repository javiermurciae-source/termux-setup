#!/data/data/com.termux/files/usr/bin/bash
# ══════════════════════════════════════════════════════════
#  setup-todo — Restauración completa de entorno Termux
#  Ejecutar UNA sola vez. Requiere internet.
# ══════════════════════════════════════════════════════════

FLAG="$HOME/.core_setup_done"
if [ -f "$FLAG" ]; then
    echo "Ya fue configurado. Borra ~/.core_setup_done para repetir."
    exit 0
fi

PREFIX="/data/data/com.termux/files/usr"
HOME_DIR="/data/data/com.termux/files/home"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

banner() {
    clear
    printf '\n'
    printf '  \e[1;35m╔══════════════════════════════════════════════╗\e[0m\n'
    printf '  \e[1;35m║  🚀  Setup completo de Termux Launcher       ║\e[0m\n'
    printf '  \e[1;35m╚══════════════════════════════════════════════╝\e[0m\n\n'
}

log()  { printf '\n  \e[1;34m[%s/7]\e[0m %s\n' "$1" "$2"; }
ok()   { printf '      \e[32m✔\e[0m  %s\n' "$1"; }
warn() { printf '      \e[33m⚠\e[0m  %s\n' "$1"; }

# ── 1. Scripts personales ──────────────────────────────────
step_scripts() {
    log 1 "Copiando scripts personales..."
    mkdir -p "$HOME_DIR"
    for f in horario.sh verificar-cod.sh gif-selector.sh fzf_clipboard_scratchpad.sh; do
        src="$SCRIPT_DIR/scripts/$f"
        if [ -f "$src" ]; then
            cp "$src" "$HOME_DIR/$f" && chmod +x "$HOME_DIR/$f" && ok "$f"
        else
            warn "No encontrado: scripts/$f"
        fi
    done
}

# ── 2. Fastfetch ───────────────────────────────────────────
step_fastfetch() {
    log 2 "Instalando config Fastfetch (config.jsonc + descargas.gif)..."
    mkdir -p "$HOME_DIR/.config/fastfetch"
    for f in config.jsonc descargas.gif; do
        src="$SCRIPT_DIR/fastfetch/$f"
        if [ -f "$src" ]; then
            cp "$src" "$HOME_DIR/.config/fastfetch/$f" && ok "$f"
        else
            warn "No encontrado: fastfetch/$f"
        fi
    done
}

# ── 3. Config .termux/ ─────────────────────────────────────
step_termux_config() {
    log 3 "Restaurando config .termux/..."
    mkdir -p "$HOME_DIR/.termux/background" "$HOME_DIR/.termux/shell-integration"
    cfg="$SCRIPT_DIR/termux_config"
    for f in termux.properties termux-launcher-bindings.conf colors.properties font.ttf fonts.conf material-colors.sh material-colors.properties; do
        [ -f "$cfg/$f" ] && cp "$cfg/$f" "$HOME_DIR/.termux/" && ok "$f"
    done
    [ -f "$cfg/background/background.jpeg" ] \
        && cp "$cfg/background/background.jpeg" "$HOME_DIR/.termux/background/" && ok "background.jpeg"
    [ -f "$cfg/shell-integration/termux-launcher.bash" ] \
        && cp "$cfg/shell-integration/termux-launcher.bash" "$HOME_DIR/.termux/shell-integration/" && ok "termux-launcher.bash"
    [ -f "$cfg/shell-integration/termux-launcher.zsh" ] \
        && cp "$cfg/shell-integration/termux-launcher.zsh"  "$HOME_DIR/.termux/shell-integration/" && ok "termux-launcher.zsh"
}

# ── 4. Paquetes base ───────────────────────────────────────
step_packages() {
    log 4 "Optimizando servidores de descarga (Mirrors automáticos a Purdue (EE.UU))..."
    echo "deb https://plug-mirror.rcac.purdue.edu/termux/termux-main stable main" > $PREFIX/etc/apt/sources.list
    if [ -f "$PREFIX/etc/apt/sources.list.d/root.list" ]; then
        echo "deb https://plug-mirror.rcac.purdue.edu/termux/termux-root root stable" > $PREFIX/etc/apt/sources.list.d/root.list
    fi
    
    log 4.1 "Actualizando e instalando paquetes base, glibc y herramientas Root/ADB..."
    pkg update -y && pkg upgrade -y 2>/dev/null
    
    # Repositorios extra
    pkg install -y root-repo glibc-repo 2>/dev/null
    pkg update -y 2>/dev/null
    
    # Paquetes base y glibc
    pkg install -y glibc proot 2>/dev/null
    
    # Herramientas generales + Root + ADB
    pkg install -y fish git curl fzf sqlite cowsay nyancat termux-api yazi tsu android-tools python ruby jq nmap whois dnsutils golang alpine espeak aapt aapt2 apksigner dx ecj 2>/dev/null
    
    ok "Paquetes instalados (incluyendo sudo/tsu y ADB)"
}

# ── 5. setup-launcher (showcase oficial) ──────────────────
step_setup_launcher() {
    log 5 "Verificando showcase oficial (Fish, OhMyPosh, Neovim)..."
    cd "$HOME_DIR" || true
    
    # Auto-reparación: Si el config.fish fue corrompido por el sed antiguo (falta la función base), lo borramos para forzar su regeneración.
    if [ -f "$HOME_DIR/.config/fish/config.fish" ] && ! grep -q "function __move_cursor_to_bottom" "$HOME_DIR/.config/fish/config.fish"; then
        rm -f "$HOME_DIR/.config/fish/config.fish"
        warn "Se detectó un config.fish corrupto. Reparando..."
    fi
    
    if [ -x "$HOME_DIR/.local/bin/fastfetch" ] && [ -f "$HOME_DIR/.config/fish/config.fish" ]; then
        ok "El showcase ya está instalado. ¡Omitiendo descarga pesada! ⚡"
    else
        warn "Descargando e instalando showcase desde GitHub..."
        curl -fSLO https://raw.githubusercontent.com/PickleHik3/termux-launcher/main/docs/en/examples/setup-launcher
        sh setup-launcher << 'EOF'
1
y
EOF
        ok "Showcase instalado correctamente"
    fi

    # Enlaces globales
    for bin in fastfetch sigye kitten setup-nvim; do
        if [ -f "$HOME_DIR/.local/bin/$bin" ]; then
            ln -sf "$HOME_DIR/.local/bin/$bin" "$PREFIX/bin/$bin"
        fi
    done
}

# ── 6. Fish config + fastfetch al arrancar ─────────────────
