step_recon_scraping() {
    log 8 "Instalando entorno de Web Scraping y Reconocimiento (WhatWeb)..."
    
    # Librerías de Python para Scraping (requests, bs4)
    pip install --upgrade pip >/dev/null 2>&1
    pip install requests beautifulsoup4 >/dev/null 2>&1
    ok "Librerías de Python para Scraping instaladas"
    
    # Instalación de WhatWeb (Escáner de huellas y tecnologías web)
    if [ ! -d "$HOME_DIR/.local/share/WhatWeb" ]; then
        log 8.1 "Descargando WhatWeb desde GitHub..."
        git clone --progress --depth 1 https://github.com/urbanadventurer/WhatWeb.git "$HOME_DIR/.local/share/WhatWeb"
        ln -sf "$HOME_DIR/.local/share/WhatWeb/whatweb" "$PREFIX/bin/whatweb"
        
        # Dependencias de Ruby para WhatWeb
        gem install bundler >/dev/null 2>&1
        cd "$HOME_DIR/.local/share/WhatWeb" && bundle install >/dev/null 2>&1
        ok "WhatWeb (Reconocimiento Web) instalado correctamente 🕵️"
    else
        ok "WhatWeb ya está instalado. ¡Omitiendo descarga! ⚡"
    fi

    # Herramientas de Fuzzing y Diccionarios
    echo -e "\n\e[1;33m❓ ¿Deseas instalar el entorno de Fuzzing (Ffuf) y SecLists (~1GB)? [S/n]: \e[0m\c"
    read -r -t 15 resp_fuzz
    if [[ "$resp_fuzz" =~ ^([sS]|)$ ]] || [[ -z "$resp_fuzz" ]]; then
        log 8.2 "Instalando Fuzzing (ffuf) y SecLists..."
        if [ ! -d "$HOME_DIR/wordlists/SecLists" ]; then
        mkdir -p "$HOME_DIR/wordlists"
        warn "Descargando SecLists (~1GB). Mostrando progreso..."
        git clone --progress --depth 1 https://github.com/danielmiessler/SecLists.git "$HOME_DIR/wordlists/SecLists"
        ok "Diccionarios de SecLists descargados 📚"
    else
        ok "SecLists ya está descargado. ¡Omitiendo! ⚡"
    fi

    if [ ! -x "$PREFIX/bin/ffuf" ]; then
        export GOPATH="$HOME_DIR/go"
        warn "Compilando Ffuf en Go (Esto puede tardar un par de minutos)..."
        warn "Compilando Ffuf (Go)..."
        go install -v github.com/ffuf/ffuf/v2@latest
        ln -sf "$GOPATH/bin/ffuf" "$PREFIX/bin/ffuf"
        ok "Ffuf (Fuzzer ultrarrápido) instalado 🚀"
    else
        ok "Ffuf ya está instalado. ¡Omitiendo! ⚡"
    fi
    else
        warn "Omitiendo instalación de Fuzzing y SecLists."
    fi
}


step_advanced_lab() {
    log 9 "Instalando Laboratorio Avanzado (Redes, Ing. Inversa y Desarrollo)..."

    # 1. Analista de Red (Sniffers)
    log 9.1 "Instalando Analizadores de Red (tcpdump, tshark)..."
    pkg install -y tcpdump tshark >/dev/null 2>&1
    
    # 2. Creación de Apps (Java JDK y Gradle)
    if ! command -v gradle >/dev/null 2>&1; then
        log 9.2 "Instalando Java JDK 17 y compilador Gradle (Esto tardará un momento)..."
        pkg install -y openjdk-17 gradle
    else
        ok "Java y Gradle ya instalados. ¡Omitiendo! ⚡"
    fi
    
    # 3. Ingeniería Inversa (Apktool y Jadx)
    log 9.3 "Instalando descompiladores (apktool, jadx)..."
    # Habilitar repositorio TUR que contiene estas herramientas
    pkg install -y tur-repo >/dev/null 2>&1
    pkg update -y >/dev/null 2>&1
    
    if ! command -v jadx >/dev/null 2>&1; then
        pkg install -y jadx
    else
        ok "Jadx ya instalado. ¡Omitiendo! ⚡"
    fi

    if ! command -v apktool >/dev/null 2>&1; then
        pkg install -y apktool
        # Fallback manual si el repo falla
        if ! command -v apktool >/dev/null 2>&1; then
            warn "Descargando Apktool de forma manual..."
            wget --show-progress -q https://raw.githubusercontent.com/iBotPeaches/Apktool/master/scripts/linux/apktool -O $PREFIX/bin/apktool
            wget --show-progress -q https://bitbucket.org/iBotPeaches/apktool/downloads/apktool_2.9.3.jar -O $PREFIX/bin/apktool.jar
            chmod +x $PREFIX/bin/apktool $PREFIX/bin/apktool.jar
        fi
    else
        ok "Apktool ya instalado. ¡Omitiendo! ⚡"
    fi

    ok "Laboratorio Avanzado listo 🔬 (tcpdump, java, gradle, apktool)"
}

