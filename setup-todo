        print(f"{C_BLUE}⏳ Sincronizando base de datos oficial de Exploit-DB...{C_RESET}")
        try:
            req = urllib.request.Request(CSV_URL, headers={'User-Agent': 'Mozilla/5.0'})
            with urllib.request.urlopen(req, timeout=30) as response, open(DB_FILE, 'wb') as out_file:
                out_file.write(response.read())
            print(f"{C_GREEN}✔ Base de datos sincronizada.{C_RESET}\n")
        except Exception:
            pass

def search_exploits(terms):
    check_or_download_db()
    
    if not terms:
        print(f"{C_YELLOW}Uso: searchsploit <término1> [término2] ...{C_RESET}")
        print(f"Ejemplo: searchsploit apache 2.4\n")
        sys.exit(0)

    query_str = " ".join(terms)
    regex_patterns = [re.compile(re.escape(t), re.IGNORECASE) for t in terms]
    
    results = []
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, mode='r', encoding='utf-8', errors='ignore') as f:
                reader = csv.DictReader(f)
                for row in reader:
                    desc = row.get("description", "")
                    author = row.get("author", "")
                    exploit_type = row.get("type", "")
                    platform = row.get("platform", "")
                    
                    full_text = f"{desc} {author} {exploit_type} {platform}"
                    if all(p.search(full_text) for p in regex_patterns):
                        results.append(row)
        except Exception:
            pass

    print(f"\n{C_CYAN}╭──────────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│     🛡️  EXPLOIT DATABASE & CVE VULNERABILITY SCANNER  ⚡      │{C_RESET}")
    print(f"{C_CYAN}╰──────────────────────────────────────────────────────────────╯{C_RESET}\n")
    print(f"{C_YELLOW}🔍 Búsqueda:{C_RESET} {C_WHITE}{query_str}{C_RESET} | {C_GREEN}Exploits / CVEs Encontrados: {len(results)}{C_RESET}\n")

    if not results:
        print(f"{C_RED}❌ No se encontraron exploits en la base de datos para: '{query_str}'{C_RESET}")
        print(f"{C_YELLOW}💡 Enlace web directo:{C_RESET} {C_CYAN}https://www.exploit-db.com/search?q={urllib.parse.quote_plus(query_str)}{C_RESET}\n")
        return

    # Imprimir tabla limpia y formateada
    for r in results[:25]:
        eid = r.get("id", "")
        desc = r.get("description", "")
        platform = r.get("platform", "multiple")
        date_pub = r.get("date_published", "")
        link = f"https://www.exploit-db.com/exploits/{eid}"

        print(f"  {C_CYAN}[EDB-{eid}]{C_RESET} {C_BOLD}{C_WHITE}{desc}{C_RESET}")
        print(f"      🏷️  Plataforma: {C_YELLOW}{platform}{C_RESET} | Fecha: {C_DIM}{date_pub}{C_RESET}")
        print(f"      🔗 Web: {C_BLUE}{C_UNDERLINE}{link}{C_RESET}\n")

    if len(results) > 25:
        print(f"{C_YELLOW}⚠ Mostrando los primeros 25 de {len(results)} resultados.{C_RESET}\n")

if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ["-u", "--update", "update"]:
