    TESSDATA_DIR="$PREFIX/share/tessdata"
    SPA_TESSDATA="$TESSDATA_DIR/spa.traineddata"
    if [ ! -f "$SPA_TESSDATA" ]; then
        log 10.1 "Descargando modelo OCR español (spa.traineddata)..."
        SPA_URL="https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/spa.traineddata"
        SPA_SHA="6f2e04d02774a18f01bed44b1111f2cd7f3ba7ac9dc4373cd34d59067c4f4e47"
        curl -fSL "$SPA_URL" -o "$SPA_TESSDATA" 2>/dev/null
        DOWNLOADED_SHA=$(sha256sum "$SPA_TESSDATA" 2>/dev/null | cut -d' ' -f1)
        if [ "$DOWNLOADED_SHA" = "$SPA_SHA" ]; then
            ok "spa.traineddata verificado (SHA-256 ✔)"
        else
            rm -f "$SPA_TESSDATA"
            warn "spa.traineddata falló la verificación SHA-256 (esperado: $SPA_SHA, obtuvo: $DOWNLOADED_SHA)"
        fi
    else
        ok "spa.traineddata ya presente"
    fi

