#!/data/data/com.termux/files/usr/bin/bash
# ══════════════════════════════════════════════════════════
#  setup-todo — Restauración completa de entorno Termux
#  Ejecutar UNA sola vez. Requiere internet.
# ══════════════════════════════════════════════════════════

FLAG="$HOME/.core_setup_done"
if [ -f "$FLAG" ]; then
    echo "Ya fue configurado. Borra ~/.core_setup_done para repetir."
    exit 0
fi

PREFIX="/data/data/com.termux/files/usr"
HOME_DIR="/data/data/com.termux/files/home"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

banner() {
    clear
    printf '\n'
    printf '  \e[1;35m╔══════════════════════════════════════════════╗\e[0m\n'
    printf '  \e[1;35m║  🚀  Setup completo de Termux Launcher       ║\e[0m\n'
    printf '  \e[1;35m╚══════════════════════════════════════════════╝\e[0m\n\n'
}

log()  { printf '\n  \e[1;34m[%s/7]\e[0m %s\n' "$1" "$2"; }
ok()   { printf '      \e[32m✔\e[0m  %s\n' "$1"; }
warn() { printf '      \e[33m⚠\e[0m  %s\n' "$1"; }

# ── 1. Scripts personales ──────────────────────────────────
step_scripts() {
    log 1 "Copiando scripts personales..."
    mkdir -p "$HOME_DIR"
    for f in horario.sh verificar-cod.sh gif-selector.sh fzf_clipboard_scratchpad.sh; do
        src="$SCRIPT_DIR/scripts/$f"
        if [ -f "$src" ]; then
            cp "$src" "$HOME_DIR/$f" && chmod +x "$HOME_DIR/$f" && ok "$f"
        else
            warn "No encontrado: scripts/$f"
        fi
    done
}

# ── 2. Fastfetch ───────────────────────────────────────────
step_fastfetch() {
    log 2 "Instalando config Fastfetch (config.jsonc + descargas.gif)..."
    mkdir -p "$HOME_DIR/.config/fastfetch"
    for f in config.jsonc descargas.gif; do
        src="$SCRIPT_DIR/fastfetch/$f"
        if [ -f "$src" ]; then
            cp "$src" "$HOME_DIR/.config/fastfetch/$f" && ok "$f"
        else
            warn "No encontrado: fastfetch/$f"
        fi
    done
}

# ── 3. Config .termux/ ─────────────────────────────────────
step_termux_config() {
    log 3 "Restaurando config .termux/..."
    mkdir -p "$HOME_DIR/.termux/background" "$HOME_DIR/.termux/shell-integration"
    cfg="$SCRIPT_DIR/termux_config"
    for f in termux.properties termux-launcher-bindings.conf colors.properties font.ttf fonts.conf material-colors.sh material-colors.properties; do
        [ -f "$cfg/$f" ] && cp "$cfg/$f" "$HOME_DIR/.termux/" && ok "$f"
    done
    [ -f "$cfg/background/background.jpeg" ] \
        && cp "$cfg/background/background.jpeg" "$HOME_DIR/.termux/background/" && ok "background.jpeg"
    [ -f "$cfg/shell-integration/termux-launcher.bash" ] \
        && cp "$cfg/shell-integration/termux-launcher.bash" "$HOME_DIR/.termux/shell-integration/" && ok "termux-launcher.bash"
    [ -f "$cfg/shell-integration/termux-launcher.zsh" ] \
        && cp "$cfg/shell-integration/termux-launcher.zsh"  "$HOME_DIR/.termux/shell-integration/" && ok "termux-launcher.zsh"
}

# ── 4. Paquetes base ───────────────────────────────────────
step_packages() {
    log 4 "Actualizando e instalando paquetes base y glibc..."
    pkg update -y && pkg upgrade -y
    
    # Pre-instalar glibc-repo y actualizar lista ANTES de instalar paquetes
    # (Esto soluciona el error 'Failed to install glibc' de Core-Termux)
    pkg install -y glibc-repo 2>/dev/null
    pkg update -y 2>/dev/null
    pkg install -y glibc proot 2>/dev/null
    
    pkg install -y fish git curl fzf sqlite cowsay nyancat termux-api yazi 2>/dev/null
    ok "Paquetes base, glibc y dependencias instalados"
}

# ── 5. setup-launcher (showcase oficial) ──────────────────
step_setup_launcher() {
    log 5 "Instalando showcase oficial descargando desde GitHub..."
    cd "$HOME_DIR" || true
    
    # Descarga literal como pediste, directo al HOME del celular
    curl -fsSLO https://raw.githubusercontent.com/PickleHik3/termux-launcher/main/docs/en/examples/setup-launcher
    
    # Ejecutar pasando 1 (Todo) y y (Fish Default)
    sh setup-launcher << 'EOF'
1
y
EOF

    # FIX para fastfetch: setup-launcher lo instala en ~/.local/bin/fastfetch
    # Creamos un enlace global para que funcione al instante en cualquier lado
    for bin in fastfetch sigye kitten setup-nvim; do
        if [ -f "$HOME_DIR/.local/bin/$bin" ]; then
            ln -sf "$HOME_DIR/.local/bin/$bin" "$PREFIX/bin/$bin"
        fi
    done
    
    ok "setup-launcher ejecutado correctamente"
}

# ── 6. Fish config + fastfetch al arrancar ─────────────────
step_fish_config() {
    log 6 "Configurando Fish + fastfetch al arrancar..."
    
    # Inyectar fastfetch al final de la función fish_greeting del config.fish oficial
    FISH_CFG="$HOME_DIR/.config/fish/config.fish"
    if [ -f "$FISH_CFG" ]; then
        # Remover fastfetch si ya existe para evitar duplicados
        sed -i '/fastfetch/d' "$FISH_CFG"
        # Añadirlo justo después de __move_cursor_to_bottom en fish_greeting
        sed -i '/__move_cursor_to_bottom/a \        fastfetch 2>/dev/null' "$FISH_CFG"
        ok "fastfetch añadido al inicio (fish_greeting)"
    fi

    PERSONAL="$HOME_DIR/.config/fish/conf.d/personal.fish"
    mkdir -p "$HOME_DIR/.config/fish/conf.d"
    touch "$PERSONAL"
    # Añadir siempre nuestros alias al personal.fish si no están
    if ! grep -q "horario" "$PERSONAL" 2>/dev/null; then
        cat >> "$PERSONAL" << 'PERSONAL_FISH'

# === Configuración personal ===
alias ll='ls -la'
alias ..='cd ..'
alias cls='clear'
alias update='pkg update -y && pkg upgrade -y'
alias horario='bash ~/horario.sh'
alias gif='bash ~/gif-selector.sh'
alias clip='bash ~/fzf_clipboard_scratchpad.sh'
alias fix-media='fix-media'
alias codc='bash ~/verificar-cod.sh'
set -gx PATH $HOME/.local/bin $PATH
PERSONAL_FISH
        ok "alias añadidos a personal.fish"
    fi

    ln -sf "$PREFIX/bin/fish" "$HOME_DIR/.termux/shell" 2>/dev/null
    ok "Fish → shell predeterminado"
}

# ── 7. Core-Termux (al final) ──────────────────────────────
step_core_termux() {
    log 7 "Instalando Core-Termux y Agentes de IA..."
    curl -fsSL https://raw.githubusercontent.com/DevCoreXOfficial/core-termux/main/install.sh | bash
    
    if [ -x "$PREFIX/bin/core" ]; then
        log 7 "Instalando IA: opencode, kilocode-cli, freebuff..."
        "$PREFIX/bin/core" install ai --opencode --kilocode-cli --freebuff
        ok "Agentes de IA instalados"
    else
        warn "No se encontró el comando 'core'. Las herramientas de IA no se instalaron."
    fi
    ok "Core-Termux listo"
}

# ══════════════════════════════════════════════════════════
banner
step_scripts
step_fastfetch
step_termux_config
step_packages
step_setup_launcher
step_fish_config
step_core_termux

touch "$FLAG"

clear
echo ""
cowsay "Todo listo. Reinicia la terminal." 2>/dev/null \
    || printf '  \e[1;32m✅  Todo listo. Reinicia la terminal.\e[0m\n'
echo ""
printf '  \e[34m🐟 Shell:\e[0m       Fish (default)\n'
printf '  \e[34m🎨 Fastfetch:\e[0m   corre al abrir terminal\n'
printf '  \e[34m🌟 Showcase:\e[0m    Fish + OhMyPosh + Neovim + eza\n'
printf '  \e[34m⚡ Core-Termux:\e[0m  instalado\n'
printf '  \e[34m📋 Scripts:\e[0m     horario · gif-selector · portapapeles\n'
echo ""
nyancat 2>/dev/null &
sleep 4
kill %1 2>/dev/null
echo ""
