step_core_termux() {
    log 7 "Verificando Core-Termux y Agentes de IA..."
    
    if [ -x "$PREFIX/bin/core" ]; then
        ok "Core-Termux ya está instalado. ¡Omitiendo reinstalación! ⚡"
    else
        warn "Instalando motor Core-Termux..."
        curl -fSLO https://raw.githubusercontent.com/DevCoreXOfficial/core-termux/main/install.sh
        # Hack para forzar que el instalador de core-termux muestre TODOS los errores
        sed -i 's|&>/dev/null||g' install.sh
        sed -i 's|>/dev/null 2>&1||g' install.sh
        bash install.sh || warn "Advertencia: El instalador de Core-Termux arrojó un error."
        rm -f install.sh
    fi
    
    # Voice & Context Agent para OpenCode (STT Teclado + TTS + Clipboard + Contexto)
    cat << 'VOICE_EOF' > "$HOME_DIR/opencode-voice.py"
#!/data/data/com.termux/files/usr/bin/python3
"""
🎙️ OPENCODE VOICE & CONTEXT SUITE (Termux AI Agent)
Generador de Contexto Real Maestro:
- Arquitectura del sistema, hardware, OS y permisos Root/APatch
- Catálogo completo con lujo de detalles de TODAS las APIs de Termux:API (Hardware, Sensores, SMS, Cámara, GPS, TTS, Diálogos, Linterna)
- Catálogo vivo de herramientas CLI instaladas y cómo ejecutarlas
- Scripts locales en Home con descripción de su función
- Cuentas IMAP configuradas y estado de red/batería
- Contenido del portapapeles
- Inyección de System Prompt Maestro para OpenCode
"""

import subprocess
import os
import sys
import json
import time

C_CYAN = "\033[1;36m"
C_BLUE = "\033[1;34m"
C_GREEN = "\033[1;32m"
C_YELLOW = "\033[1;33m"
C_MAGENTA = "\033[1;35m"
C_RED = "\033[1;31m"
C_WHITE = "\033[1;37m"
C_DIM = "\033[2;37m"
C_RESET = "\033[0m"

def speak(text):
    if not text:
        return
    clean_text = text.replace('"', '').replace("'", "").replace('\n', ' ')[:300]
    try:
        subprocess.run(["termux-tts-speak", clean_text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)
    except Exception:
        pass

def get_clipboard():
    try:
        res = subprocess.run(["termux-clipboard-get"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass
    return ""

def build_full_system_context():
    """Construye un dossier de contexto profundo de todo el entorno Termux con detalle de Termux:API"""
    ctx = []
    ctx.append("=================== ENTORNO DEL DISPOSITIVO Y SISTEMA ===================")
    ctx.append("• Dispositivo: Android / Infinix X6878 (ARM64-v8a)")
    ctx.append("• Entorno Shell: Termux + Fish Shell (PickleHik3 Termux Launcher)")
    
    # 1. Permisos Root
    has_root = os.path.exists("/system/bin/su") or os.path.exists("/data/data/com.termux/files/usr/bin/tsu")
    ctx.append(f"• Acceso Superusuario (Root): {'SI (APatch/Magisk disponible vía `su` / `tsu`)' if has_root else 'NO'}")

    # 2. Batería en vivo
    try:
        bat = subprocess.run(["termux-battery-status"], capture_output=True, text=True, timeout=1)
        if bat.returncode == 0:
            b = json.loads(bat.stdout)
            ctx.append(f"• Batería en Vivo: {b.get('percentage')}% ({b.get('status')}, Temp: {b.get('temperature', 0)/10}°C)")
    except Exception:
        pass

    ctx.append("\n=================== CATÁLOGO DE COMANDOS TERMUX:API DISPONIBLES ===================")
    ctx.append("Puedes usar y llamar a estas herramientas de Android directamente desde la terminal:")
    ctx.append("• 📋 Portapapeles:")
    ctx.append("    - `termux-clipboard-get`: Lee el portapapeles de Android.")
    ctx.append("    - `termux-clipboard-set <texto>`: Escribe texto en el portapapeles.")
    ctx.append("• 🔋 Hardware, Sensores & Linterna:")
    ctx.append("    - `termux-battery-status`: Obtiene porcentaje, salud, voltaje y estado de carga.")
    ctx.append("    - `termux-sensor -s` / `termux-sensor -n <sensor>`: Lee datos de sensores en tiempo real.")
    ctx.append("    - `termux-torch on` / `termux-torch off`: Enciende o apaga la linterna física.")
    ctx.append("    - `termux-vibrate -d <ms>`: Hace vibrar el teléfono por X milisegundos (ej: `-d 500`).")
    ctx.append("• 📷 Cámara:")
    ctx.append("    - `termux-camera-info`: Lista las cámaras frontal/trasera.")
    ctx.append("    - `termux-camera-photo <ruta.jpg>`: Toma una fotografía con la cámara.")
    ctx.append("• 📍 Ubicación:")
    ctx.append("    - `termux-location`: Obtiene las coordenadas GPS exactas (latitud, longitud, altitud).")
    ctx.append("• 🔔 Notificaciones & Diálogos:")
    ctx.append("    - `termux-notification -t 'Título' -c 'Contenido'`: Muestra una notificación en la barra de Android.")
    ctx.append("    - `termux-notification-remove <id>`: Elimina una notificación por su ID.")
    ctx.append("    - `termux-toast <texto>`: Muestra un mensaje emergente Toast en la pantalla.")
    ctx.append("    - `termux-dialog [confirm|text|radio|sheet|speech]`: Abre ventanas de diálogo nativas de Android.")
    ctx.append("    - `termux-storage-get <archivo>`: Solicita al usuario un archivo con el selector nativo.")
    ctx.append("• 📶 Conectividad & Red:")
    ctx.append("    - `termux-wifi-connectioninfo`: Muestra SSID, IP, BSSID y velocidad de enlace Wi-Fi.")
    ctx.append("    - `termux-wifi-scaninfo`: Escanea las redes Wi-Fi cercanas.")
    ctx.append("• 📞 Telefonía & SMS:")
    ctx.append("    - `termux-telephony-deviceinfo`: Información IMEI, SIM y operador.")
    ctx.append("    - `termux-telephony-cellinfo`: Información de antenas celulares.")
    ctx.append("    - `termux-sms-inbox`: Lista los mensajes SMS recibidos.")
    ctx.append("    - `termux-sms-send -n <numero> <mensaje>`: Envía un SMS.")
    ctx.append("• 🗣️ Audio & TTS:")
    ctx.append("    - `termux-tts-speak <texto>`: Sintetiza y habla texto en voz alta por el altavoz.")
    ctx.append("    - `termux-media-scan <archivo>`: Notifica al sistema para escanear multimedia.")

    ctx.append("\n=================== SCRIPTS Y UTILIDADES LOCALES ===================")
    
    # 3. Scripts en Home y su función
    home = os.path.expanduser("~")
    script_descriptions = {
        "readmail": "Lector IMAP interactivo de correos Gmail/Dominio con tarjetas ANSI (alias `mail` / `leer-correo.sh`)",
        "verificar-cod.sh": "Extractor automatizado de códigos de verificación y OTP por IMAP (alias `codc`)",
        "setup-todo": "Script maestro de aprovisionamiento, restauración y configuración del entorno",
        "fzf_clipboard_scratchpad.sh": "Gestor flotante de portapapeles FZF y notas rápidas",
        "horario.sh": "Gestor de horarios e itinerarios interactivo",
        "gif-selector.sh": "Selector y reproductor de animaciones GIF en terminal",
        "opencode-voice.py": "Suite de dictado por voz y contexto vivo para el agente IA"
    }

    if os.path.exists(home):
        found_scripts = []
        for f in os.listdir(home):
            if f in script_descriptions:
                found_scripts.append(f"  - `{f}`: {script_descriptions[f]}")
            elif f.endswith(".sh") or f.endswith(".py"):
                found_scripts.append(f"  - `{f}`: Script de usuario en Python/Bash")
        ctx.append("📁 Scripts en el directorio Home (~/):")
        ctx.extend(found_scripts if found_scripts else ["  - Ninguno"])

    # 4. Cuentas de Correo
    mail_cfg = os.path.expanduser("~/.config/mail_accounts.json")
    if os.path.exists(mail_cfg):
        try:
            with open(mail_cfg) as f:
                accs = json.load(f)
                acc_summary = [f"{name} ({data.get('email')})" for name, data in accs.items()]
                ctx.append(f"\n📬 Cuentas de Correo Configuradas en IMAP: {', '.join(acc_summary) if acc_summary else 'Ninguna'}")
        except Exception:
            pass

    # 5. Suite de Pentesting, Red y Reversing instalada
    ctx.append("\n🛠️ Herramientas CLI del Ecosistema:")
    ctx.append("  - Red & Sniffing: `nmap`, `tcpdump`, `tshark` (Wireshark CLI), `whois`, `dnsutils`")
    ctx.append("  - Fuzzing & Web: `ffuf` (Go), `SecLists` (~/wordlists/SecLists), `whatweb`, `curl`")
    ctx.append("  - Reversing Android & Java: `jadx` (descompilador APK), `apktool`, `openjdk-17`, `gradle`")
    ctx.append("  - Utilidades Terminal: `fzf`, `yazi` (explorador de archivos), `eza`, `fastfetch`, `cowsay`, `nyancat`")
    ctx.append("  - Agentes IA CLI: `opencode`, `agy` (Antigravity), `kilo` (KiloCode), `keelcode`, `qwen`, `cline`")

    # 6. Portapapeles
    clip = get_clipboard()
    if clip:
        ctx.append(f"\n📋 Contenido Actual del Portapapeles (Android Clipboard):\n\"\"\"\n{clip}\n\"\"\"")

    return "\n".join(ctx)

def main():
    print(f"{C_CYAN}╭────────────────────────────────────────────────────────╮{C_RESET}")
    print(f"{C_CYAN}│   🎙️  OPENCODE VOICE & CONTEXT AGENT (TERMUX AI)  ⚡   │{C_RESET}")
    print(f"{C_CYAN}╰────────────────────────────────────────────────────────╯{C_RESET}\n")

    if "--auth" in sys.argv or "auth" in sys.argv or "--providers" in sys.argv:
        os.system("opencode auth")
        sys.exit(0)

    # Construir el dossier de contexto real
    full_context = build_full_system_context()
    
    print(f"{C_MAGENTA}🧠 Contexto Vivo del Sistema Recolectado:{C_RESET}")
    print(f"{C_DIM}{full_context}{C_RESET}\n")

    print(f"{C_YELLOW}🎤 Toca el micrófono de tu teclado para dictar o escribe tu orden:{C_RESET}\n")
    sys.stdout.write(f"{C_GREEN}🗣️  Tú: {C_RESET}")
    sys.stdout.flush()
