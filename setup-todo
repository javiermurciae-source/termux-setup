    echo -e "\n\e[1;33m❓ ¿Deseas restaurar la lista de Aplicaciones Ancladas (WhatsApp, Brave, ChatGPT, etc.)? [S/n]: \e[0m\c"
    read -r -t 15 resp_pinned
    if [[ "$resp_pinned" =~ ^([sS]|)$ ]] || [[ -z "$resp_pinned" ]]; then
        log 10.2 "Restaurando aplicaciones ancladas en el Launcher..."
        mkdir -p "/data/data/com.termux/shared_prefs"
        python -c '
